# ── FRANCIS · environment ──────────────────────────────────────────
# Public Supabase credentials (safe to expose — RLS enforces access)
NEXT_PUBLIC_SUPABASE_URL=https://ojzcgeckdrvxvkfphtma.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_IK7F0F93SHgLe3eXTX1xyA_eCkED4bV

# Server-only service role (Supabase → Settings → API → service_role). NEVER expose.
SUPABASE_SERVICE_ROLE_KEY=

# FRANCIS AI — any OpenAI-compatible provider. Server-only.
# OpenAI:   AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
# Groq:     AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
# Together: AI_BASE_URL=https://api.together.xyz/v1
# Ollama:   AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=llama3.2
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_PROVIDER_LABEL=OpenAI-compatible

# Optional: Serper.dev for higher-quality search results (https://serper.dev)
# Without it, FRANCIS AI uses DuckDuckGo's results page server-side (no key needed).
SERPER_API_KEY=

# Canonical site URL used for sitemap/OG
NEXT_PUBLIC_SITE_URL=https://francis-platform.vercel.app
