# ─── FRANCIS platform environment ────────────────────────────────────────────
# Public (browser-safe) Supabase credentials — used by the portfolio renderer and admin studio.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key — used ONLY in API routes (contact, AI, documents). Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for sitemap/OG metadata)
NEXT_PUBLIC_SITE_URL=https://francis-platform.vercel.app

# ─── FRANCIS AI provider (server-only) ───────────────────────────────────────
# Any OpenAI-compatible Chat Completions endpoint. Examples:
#   OpenAI:    https://api.openai.com/v1        model: gpt-4o-mini
#   Google:    https://generativelanguage.googleapis.com/v1beta/openai   model: gemini-2.0-flash
#   Groq:      https://api.groq.com/openai/v1   model: llama-3.3-70b-versatile
#   OpenRouter:https://openrouter.ai/api/v1     model: meta-llama/llama-3.3-70b-instruct
AI_PROVIDER=openai-compatible
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# ─── Web search for research mode (server-only) ─────────────────────────────
# DuckDuckGo works with no key (default). Optional higher-quality providers:
SEARCH_PROVIDER=duckduckgo
SERPER_API_KEY=
BING_API_KEY=
